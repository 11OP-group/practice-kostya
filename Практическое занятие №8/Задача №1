# Запрашиваем у пользователя число n
n = int(input("Введите число n: "))

# Цикл с параметром: i будет меняться от 1 до 10 включительно
for i in range(1, 11):
    # Считаем результат умножения
    result = n * i
    # Выводим строку в нужном формате с помощью f-строки
    print(f"{n} x {i} = {result}")

