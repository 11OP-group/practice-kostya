n = int(input())
total_sum = 0 # Переменная для накопления суммы

# Цикл от 1 до n включительно
for i in range(1, n + 1):
    if i % 2 != 0: # Если число нечётное (1, 3, 5...)
        total_sum += i # Прибавляем
    else:          # Если чётное (2, 4, 6...)
        total_sum -= i # Вычитаем

print(total_sum)
