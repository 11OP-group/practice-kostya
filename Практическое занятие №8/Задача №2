all_even = True  # Изначально предполагаем, что все числа четные

# Цикл выполнится ровно 10 раз (нижнее подчеркивание _ значит, что счетчик нам не важен)
for _ in range(10):
    num = int(input()) # Считываем число
    if num % 2 != 0:   # Если число нечетное
        all_even = False # Меняем флаг на Ложь

# После цикла проверяем, остался ли флаг правдой
if all_even:
    print("YES")
else:
    print("NO")
