n = int(input()) # Количество чисел

max1 = 0 # Первое максимальное
max2 = 0 # Второе максимальное

# Запускаем цикл n раз
for _ in range(n):
    num = int(input())
    
    # Если число больше первого максимума
    if num > max1:
        max2 = max1 # Старый максимум сдвигается на второе место
        max1 = num  # Новое число становится первым
    # Иначе, если число больше второго максимума (но меньше первого)
    elif num > max2:
        max2 = num # Оно становится вторым

print(max1)
print(max2)
