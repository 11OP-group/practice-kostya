import random # Подключаем модуль для генерации случайных чисел

# Считываем статус и переводим его в нижний регистр (чтобы "Pending" тоже работало)
status = input("Введите статус заказа: ").lower()

print("=" * 40)
print("      📦 СТАТУС ВАШЕГО ЗАКАЗА 📦")
print("=" * 40)

# Проверяем статус через match-case
match status:
    case "pending":
        print("Статус: В ожидании ⏳")
        print("Описание: Заказ оформлен, но ещё не передан в обработку.")
        print(f"Примерное время: {random.randint(1, 2)} дня")
        print("Рекомендация: Ожидайте подтверждения заказа.")
    case "processing":
        print("Статус: В обработке ⚙️")
        print("Описание: Ваш заказ собирается на складе.")
        print(f"Примерное время: {random.randint(2, 3)} дня")
        print("Рекомендация: Пожалуйста, ожидайте передачи в доставку.")
    case "shipped":
        print("Статус: Отправлено 🚚")
        print("Описание: Ваш заказ находится в пути к вам.")
        print(f"Примерное время: {random.randint(2, 5)} дней")
        print("Рекомендация: Следите за уведомлениями о доставке.")
    case "delivered":
        print("Статус: Доставлено ✅")
        print("Описание: Ваш заказ успешно доставлен.")
        print("Примерное время: 0 дней")
        print("Рекомендация: Спасибо за заказ!")
    case "cancelled":
        print("Статус: Отменено ❌")
        print("Описание: Ваш заказ был отменён.")
        print("Примерное время: —")
        print("Рекомендация: Свяжитесь с поддержкой.")
    case _: # Если ввели что-то неизвестное
        print(f"❌ Ошибка: Неизвестный статус \"{status}\"")
        print("Доступные статусы: pending, processing, shipped, delivered, cancelled")

