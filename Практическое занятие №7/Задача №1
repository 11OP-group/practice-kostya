# Считываем рейтинг с клавиатуры и превращаем в целое число
rating = int(input("Введите рейтинг продукта (от 1 до 10): "))

# Используем match-case для проверки значения
match rating:
    # Если ввели 9 или 10
    case 9 | 10:
        print("Отличный продукт! 🌟 Настоятельно рекомендую!")
    # Если ввели 7 или 8
    case 7 | 8:
        print("Хороший продукт 👍 Можно попробовать")
    # Если ввели 5 или 6
    case 5 | 6:
        print("Средний продукт 😐 Можно попробовать")
    # Если ввели 3 или 4
    case 3 | 4:
        print("Плохой продукт 👎 Не рекомендую")
    # Если ввели 1 или 2
    case 1 | 2:
        print("Очень плохой продукт ❌ Не рекомендую")
    # case _ (нижнее подчеркивание) срабатывает, если ни один вариант выше не подошел
    case _:
        print("Ошибка: рейтинг должен быть от 1 до 10")
