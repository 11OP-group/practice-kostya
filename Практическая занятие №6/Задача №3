# Считываем 4 числа (столбец и строка для 1-й клетки, потом для 2-й)
x1 = int(input())
y1 = int(input())
x2 = int(input())
y2 = int(input())

# Складываем координаты каждой клетки
sum1 = x1 + y1
sum2 = x2 + y2

# Если остатки от деления на 2 одинаковые, значит клетки одного цвета, если нет, то клетки разного цвета
if sum1 % 2 == sum2 % 2:
    print("YES")
else:
    print("NO")
