# Считываем координаты двух клеток
x1 = int(input())
y1 = int(input())
x2 = int(input())
y2 = int(input())

# Находим, насколько изменился столбец и строка
# Функция abs() убирает минус, чтобы мы просто узнали расстояние
diff_x = abs(x1 - x2)
diff_y = abs(y1 - y2)
#diff — это просто сокращение от английского слова difference

# Если расстояния по X и по Y равны, значит это диагональ
if diff_x == diff_y:
    print("YES")
else:
    print("NO")
