num = int(input("Введите номер кармана (0-36): "))

# 1. Ошибка ввода (если число меньше 0 или больше 36)
if num < 0 or num > 36:
    print("ошибка ввода")

# 2. Зеленый карман (только ноль)
elif num == 0:
    print("зеленый")

# 3. Диапазон 1-10: нечетные - красные, четные - черные
elif 1 <= num <= 10:
    if num % 2 != 0: # проверка на нечетность
        print("красный")
    else:
        print("черный")

# 4. Диапазон 11-18: тут цвета наоборот (нечетные - черные)
elif 11 <= num <= 18:
    if num % 2 != 0:
        print("черный")
    else:
        print("красный")

# 5. Диапазон 19-28: как в 1-10 (нечетные - красные)
elif 19 <= num <= 28:
    if num % 2 != 0:
        print("красный")
    else:
        print("черный")

# 6. Диапазон 29-36: как в 11-18 (нечетные - черные)
elif 29 <= num <= 36:
    if num % 2 != 0:
        print("черный")
    else:
        print("красный")
