x1 = int(input())
y1 = int(input())
x2 = int(input())
y2 = int(input())

# Если совпадают столбцы (x1 == x2), это ход по вертикали
# Если совпадают строки (y1 == y2), это ход по горизонтали
# Если разницы по X и Y равны (abs(x1-x2) == abs(y1-y2)), это ход по диагонали
# Объединяем все это через or (ИЛИ)
if x1 == x2 or y1 == y2 or abs(x1 - x2) == abs(y1 - y2):
    print("YES")
else:
    print("NO")
