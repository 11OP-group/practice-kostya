# Считываем три числа, которые нужно ввести по условию
temp = float(input("Введите температуру: "))
pressure = int(input("Введите верхнее давление: "))
pulse = int(input("Введите пульс: "))

# 1. ПРОВЕРКА НА ВРАЧА (самое опасное)
# Если ХОТЯ БЫ один параметр вышел за критические рамки — отправляем к врачу
if (temp < 35 or temp > 38) or (pressure < 105 or pressure > 140) or (pulse < 55 or pulse > 110):
    print("Требуется врач!")

# 2. ПРОВЕРКА НА ЛЕГКОЕ НЕДОМОГАНИЕ
# Сюда мы попадаем, если к врачу идти не надо, но параметры не идеальны
# Используем elif (иначе если), чтобы не проверять это, если уже сработал врач
elif (35 <= temp <= 36 or 37 <= temp <= 38) or (105 <= pressure <= 110 or 130 <= pressure <= 140) or (55 <= pulse <= 60 or 100 <= pulse <= 110):
    print("Легкое недомогание, пойдёт.")

# 3. ЕСЛИ ВСЕ ИДЕАЛЬНО
# Если ни врач, ни недомогание не сработали — значит, все в норме
else:
    print("Нормалды.")
